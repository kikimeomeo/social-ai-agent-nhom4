<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Row 1: Author + Platform Icon + Category Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCommentPlatform"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_facebook" />

            <TextView
                android:id="@+id/tvAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Minh Anh" />

            <TextView
                android:id="@+id/tvCommentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                tools:text="• 5 phút trước" />

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_pill"
                android:backgroundTint="@color/status_green_bg"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="Khen ngợi"
                android:textColor="@color/status_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Comment Content -->
        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="App có hỗ trợ tự nhập Gemini API Key cá nhân không bạn?" />

        <!-- Row 3: Status + Tap hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReplyStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa trả lời"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Chạm để trả lời"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Hidden legacy bound views preserved for CommentAdapter -->
        <TextView android:id="@+id/tvPostContextTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvAuthorAvatar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/layoutAlertWarning" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <TextView android:id="@+id/tvAlertWarningText" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />
</LinearLayout>

