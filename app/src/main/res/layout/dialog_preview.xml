<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề Dialog xem trước & duyệt bài -->
        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁️ Xem trước &amp; Duyệt bài đăng"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Chốt chặn an toàn Human-in-the-loop -->
        <LinearLayout
            android:id="@+id/bannerSafetyGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_pill"
            android:backgroundTint="@color/status_green_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/tvSafetyGateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Chốt chặn an toàn: AI tuyệt đối không tự ý đăng bài khi bạn chưa bấm Xác nhận duyệt."
                android:textColor="@color/status_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bộ chuyển đổi kênh xem trước: Facebook Page / Threads -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SocialCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabPreviewPlatform"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/primary"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="2.5dp"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:tabTextColor="@color/text_muted">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facebook Page" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Threads (≤ 500)" />
            </com.google.android.material.tabs.TabLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mock Social Header theo từng kênh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPreviewPlatformIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Biểu tượng nền tảng"
                android:src="@drawable/ic_facebook" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPreviewAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Tech Vietnam (Facebook Page)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewSubInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vừa xong • 🌐 Công khai"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndoRewrite"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:text="↩ Hoàn tác"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Khung xem trước & chỉnh sửa trực tiếp bài viết (Human-in-the-loop) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPostContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundColor="@color/card_bg"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/card_stroke">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPostContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Nội dung bài viết..."
                android:inputType="textMultiLine"
                android:maxLines="10"
                android:minLines="5"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bộ đếm ký tự chuẩn xác theo giới hạn Threads (500) & Facebook (63,206) -->
        <TextView
            android:id="@+id/tvCharCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="end"
            android:text="0 / 500 ký tự (Threads)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Cảnh báo an toàn nội dung (từ nhạy cảm / thiếu nguồn / PII) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreviewSafetyWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/status_amber_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Cảnh báo an toàn"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="@color/status_amber" />

                <TextView
                    android:id="@+id/tvPreviewSafetyWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#92400E"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Thanh công cụ AI Rewrite kết nối API LLM thật -->
        <TextView
            android:id="@+id/tvAiToolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🤖 Công cụ AI viết lại từng đoạn / toàn bài:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Bôi đen đoạn muốn sửa để viết lại riêng đoạn đó, hoặc bấm trực tiếp để viết lại toàn bài."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/layoutPreviewAiLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tvPreviewAiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AI đang viết lại nội dung..."
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/hsvAiTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShorten"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="✂️ Ngắn hơn"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    app:backgroundTint="@color/bg_soft_fill"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/primary_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFormal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="👔 Trang trọng hơn"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    app:backgroundTint="@color/bg_soft_fill"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/primary_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeHook"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="🪝 Đổi Hook mở đầu"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    app:backgroundTint="@color/bg_soft_fill"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/primary_light" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Khung xem trước ảnh minh họa & Nút Sinh lại ảnh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 Ảnh minh họa bài viết"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewImageSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visual Agent • Chưa tạo ảnh mới"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegenerateImage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="🔄 Sinh lại ảnh"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/bg_soft_fill"
                app:cornerRadius="17dp"
                app:strokeColor="@color/primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivPreviewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh minh họa bài đăng"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_image_placeholder" />

                <LinearLayout
                    android:id="@+id/overlayPreviewImageLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#AA0F172A"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Visual Agent đang sinh ảnh mới..."
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPreviewImagePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Prompt ảnh: Minimal 3D tech illustration..."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Hàng nút đóng & xác nhận duyệt (Human-in-the-loop Gate) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismiss"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Đóng (Giữ nháp)"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/card_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="✅ Xác nhận &amp; Duyệt"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
