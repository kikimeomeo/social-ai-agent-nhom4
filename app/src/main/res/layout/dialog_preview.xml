<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tiêu đề Dialog xem trước bài đăng -->
    <TextView
        android:id="@+id/tvPreviewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👁️ Xem trước bài đăng (Threads / Facebook)"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Khung xem trước & chỉnh sửa trực tiếp bài viết (Human-in-the-loop) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPostContent"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top"
            android:hint="Nội dung bài viết..."
            android:inputType="textMultiLine"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bộ đếm ký tự & Cảnh báo vượt giới hạn 500 ký tự (Threads) -->
    <TextView
        android:id="@+id/tvCharCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="0 / 500 ký tự"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Thanh công cụ AI Rewrite -->
    <TextView
        android:id="@+id/tvAiToolTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🤖 Công cụ AI viết lại:"
        android:textSize="14sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/hsvAiTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShorten"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✂️ Ngắn hơn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="👔 Trang trọng hơn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeHook"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🪝 Đổi Hook mở đầu" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Hàng nút đóng & lưu (Đã thêm style buttonBar chuẩn hóa giao diện Android) -->
    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDismiss"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy" />

        <Button
            android:id="@+id/btnSave"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Xác nhận &amp; Đăng" />
    </LinearLayout>
</LinearLayout>