<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Row 1: Agent Role Badge + Status Badge [WEIGHT 1] Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLogAgentRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_pill"
                android:backgroundTint="@color/primary_light"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Facebook Agent"
                android:textColor="@color/primary_dark"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_soft_pill"
                android:backgroundTint="@color/status_green_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Thành công"
                android:textColor="@color/status_green"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLogTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23:05 • 19/11"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Row 2: Step Name (Full Width, never wrapped) -->
        <TextView
            android:id="@+id/tvLogStepName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Facebook Sub-agent"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Row 3: Compact Model Pill + Metrics + Expand Hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLogModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_pill"
                android:backgroundTint="@color/bg_soft_alt"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:singleLine="true"
                android:text="gemini-3.1-flash-lite"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogMetrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="580 tok • $0.0023 • 600ms"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvLogExpandHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết ▼"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Expandable Detail Section -->
        <LinearLayout
            android:id="@+id/layoutLogDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Model Info Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/bg_soft_fill"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvLogModelDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mô hình AI: gemini-3.1-flash-lite"
                    android:textColor="@color/primary_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLogCostRateDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ước tính chi phí theo bảng giá tiêu chuẩn API."
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="PROMPT ĐÃ DÙNG"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_soft_input"
                android:lineSpacingExtra="2dp"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.05"
                android:text="KẾT QUẢ AI TRẢ VỀ"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_soft_input"
                android:lineSpacingExtra="2dp"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
